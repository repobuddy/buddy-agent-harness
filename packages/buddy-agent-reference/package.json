{
	"name": "buddy-agent-reference",
	"version": "0.0.0",
	"description": "Resolve named Markdown reference documents across managed, project, user, and plugin tiers, with merge-sections overrides",
	"keywords": [
		"repobuddy",
		"agent",
		"skills",
		"references",
		"claude-code",
		"codex",
		"cursor"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/repobuddy/buddy-agent-harness.git",
		"directory": "packages/buddy-agent-reference"
	},
	"bugs": "https://github.com/repobuddy/buddy-agent-harness/issues",
	"homepage": "https://github.com/repobuddy/buddy-agent-harness/tree/main/packages/buddy-agent-reference#readme",
	"author": {
		"name": "repobuddy"
	},
	"type": "module",
	"sideEffects": false,
	"bin": {
		"buddy-agent-reference": "./bin/buddy-agent-reference.mjs"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./command-output": {
			"types": "./dist/command-output.d.mts",
			"default": "./dist/command-output.mjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"bin",
		"dist",
		"src",
		"!**/*.{test,spec}.ts"
	],
	"scripts": {
		"build": "tsdown",
		"coverage": "vitest run --coverage",
		"prepack": "pnpm build",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"@cyberuni/agent-harness": "^0.3.0",
		"@toon-format/toon": "^4.1.1",
		"clibuilder": "^11.3.0",
		"yaml": "^2.9.0"
	},
	"devDependencies": {
		"@types/node": "^24.12.4",
		"@vitest/coverage-v8": "^5.0.0",
		"tsdown": "^0.23.0",
		"typescript": "^7.0.0",
		"vitest": "^5.0.0"
	}
}
