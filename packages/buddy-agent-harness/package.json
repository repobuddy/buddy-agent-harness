{
	"name": "buddy-agent-harness",
	"version": "0.4.1",
	"description": "Initialize standards-based agent configuration across agent harnesses",
	"keywords": [
		"repobuddy",
		"agent",
		"skills",
		"claude-code",
		"codex",
		"cursor"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/repobuddy/buddy-agent-harness.git"
	},
	"bugs": "https://github.com/repobuddy/buddy-agent-harness/issues",
	"homepage": "https://github.com/repobuddy/buddy-agent-harness#readme",
	"author": {
		"name": "repobuddy"
	},
	"type": "module",
	"bin": {
		"buddy-agent-harness": "./bin/buddy-agent-harness.mjs"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		}
	},
	"files": [
		"bin",
		"dist",
		"src",
		"!**/*.{test,spec}.ts",
		"skills",
		"plugin.json",
		".claude-plugin",
		".cursor-plugin",
		".codex-plugin"
	],
	"scripts": {
		"build": "tsdown",
		"coverage": "vitest run --coverage",
		"dev": "node bin/buddy-agent-harness.mjs",
		"prepack": "pnpm build",
		"skill:gen": "tsx scripts/generate-skills.ts",
		"skill:gen:check": "tsx scripts/generate-skills.ts --check",
		"test": "vitest run",
		"test:dist": "tsc --noEmit -p tsconfig.dist.json && vitest run --config vitest.dist.config.ts",
		"typecheck": "tsc --noEmit"
	},
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"@toon-format/toon": "^4.1.1",
		"clibuilder": "^10.0.0"
	},
	"devDependencies": {
		"@types/node": "^24.12.4",
		"@vitest/coverage-v8": "^4.1.0",
		"tsdown": "^0.22.0",
		"tsx": "^4.22.3",
		"typescript": "^7.0.0",
		"vitest": "^4.1.0"
	}
}
