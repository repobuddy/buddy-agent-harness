{
	"$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
	"name": "buddy-agent-harness",
	"version": "2.0.0",
	"description": "Initialize standards-based agent configuration across agent harnesses",
	"author": {
		"name": "repobuddy"
	},
	"homepage": "https://github.com/repobuddy/buddy-agent-harness",
	"repository": "https://github.com/repobuddy/buddy-agent-harness",
	"license": "MIT",
	"keywords": ["agent", "skills", "harness", "claude-code", "codex"],
	"extensions": {
		"org.cyberuni.universal-plugin": {
			"skills": "./skills/",
			"dependencies": ["cyber-agentkit"],
			"scripts": {
				"skills/doctor-buddy-agent-harness/scripts/buddy-agent-harness.mjs": {
					"forward": "buddy-agent-harness"
				},
				"skills/enhance-buddy-agent-harness/scripts/buddy-agent-harness.mjs": {
					"forward": "buddy-agent-harness"
				},
				"skills/init-buddy-agent-harness/scripts/buddy-agent-harness.mjs": {
					"forward": "buddy-agent-harness"
				},
				"skills/repair-buddy-agent-harness/scripts/buddy-agent-harness.mjs": {
					"forward": "buddy-agent-harness"
				},
				"skills/enhance-buddy-agent-harness/scripts/cyber-agentkit.mjs": {
					"forward": "cyber-agentkit",
					"package": "cyber-agentkit",
					"version": "1.2.0"
				}
			},
			"harnesses": {
				"claude-code": {},
				"cursor": {
					"category": "productivity",
					"tags": ["agent", "skills"]
				},
				"codex": {
					"interface": {
						"displayName": "Buddy Agent Harness",
						"category": "productivity"
					}
				},
				"copilot-cli": {}
			}
		}
	}
}
