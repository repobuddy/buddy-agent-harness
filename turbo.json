{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"//#check": { "cache": false },
		"build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
		"coverage": { "dependsOn": ["^build", "build"], "outputs": ["coverage/**"] },
		"test": { "dependsOn": ["^build", "build"] },
		"test:dist": { "dependsOn": ["build"] },
		"typecheck": { "dependsOn": ["^build"] },
		"skill:gen:check": { "cache": false },
		"verify": {
			"dependsOn": ["//#check", "build", "typecheck", "coverage", "test:dist", "skill:gen:check"]
		}
	}
}
